{
  "expo": {
    "name": "vocacional-app",
    "slug": "vocacional-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050505"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050505"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "La aplicación necesita acceso a tu galería para que puedas subir tu foto de perfil.",
          "cameraPermission": "La aplicación necesita acceso a tu cámara para tomar tu foto de perfil.",
          "colors": {
            "cropToolbarColor": "#050505"
          },
          "dark": {
            "colors": {
              "cropToolbarColor": "#050505"
            }
          }
        }
      ],
      "expo-asset"
    ]
  }
}
